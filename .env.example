# Copy to .env.local and fill in. All are VITE_* so they are baked into the JS
# bundle at `vite build` time (not read at runtime). The Google client ID + API
# key are public by design (implicit OAuth flow); see docs/adr/0009.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Needs Maps JavaScript API + Places API (New) enabled. See ADR-0013.
VITE_GOOGLE_API_KEY=your-api-key
# Optional. Cloud-configured Map ID for Advanced Markers; omit to use Google's DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=your-map-id
# Google Gemini API key — powers the AI helpers. Unlike the keys above this one
# is NOT public-by-design: it is billable and ends up in the client bundle, so
# restrict it (HTTP referrer + API restrictions) in Google Cloud, or omit it to
# disable AI features.
VITE_GEMINI_API_KEY=your-gemini-key
