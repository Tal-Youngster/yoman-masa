# Copy to .env.local and fill in. Public values; baked into the JS bundle at build time.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Needs Maps JavaScript API + Places API (New) enabled. See ADR-0013.
VITE_GOOGLE_API_KEY=your-api-key
# Optional. Cloud-configured Map ID for Advanced Markers; omit to use Google's DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=your-map-id
